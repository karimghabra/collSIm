#version 460
// Per-bead orthonormal frames by parallel transport along each molecule.
// Frame: col0 = n (cross-section x), col1 = b, col2 = t (axis). Stored as quat.
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer Pos { vec4 pos[]; };
layout(std430, binding = 6) writeonly buffer Frames { vec4 frm[]; };
layout(std430, binding = 13) readonly buffer Theta { float theta[]; };
uniform int nMol;
uniform int nBeads;

vec4 quatFromMat(vec3 c0, vec3 c1, vec3 c2) {
    float tr = c0.x + c1.y + c2.z;
    vec4 q;
    if (tr > 0.0) {
        float s = sqrt(tr + 1.0) * 2.0;
        q = vec4((c1.z - c2.y) / s, (c2.x - c0.z) / s, (c0.y - c1.x) / s, 0.25 * s);
    } else if (c0.x > c1.y && c0.x > c2.z) {
        float s = sqrt(1.0 + c0.x - c1.y - c2.z) * 2.0;
        q = vec4(0.25 * s, (c1.x + c0.y) / s, (c2.x + c0.z) / s, (c1.z - c2.y) / s);
    } else if (c1.y > c2.z) {
        float s = sqrt(1.0 + c1.y - c0.x - c2.z) * 2.0;
        q = vec4((c1.x + c0.y) / s, 0.25 * s, (c2.y + c1.z) / s, (c2.x - c0.z) / s);
    } else {
        float s = sqrt(1.0 + c2.z - c0.x - c1.y) * 2.0;
        q = vec4((c2.x + c0.z) / s, (c2.y + c1.z) / s, 0.25 * s, (c0.y - c1.x) / s);
    }
    return normalize(q);
}

void main() {
    uint m = gl_GlobalInvocationID.x;
    if (m >= uint(nMol)) return;
    int b0 = int(m) * nBeads;
    vec3 t = normalize(pos[b0 + 1].xyz - pos[b0].xyz);
    vec3 up = abs(t.z) < 0.9 ? vec3(0, 0, 1) : vec3(1, 0, 0);
    vec3 n = normalize(cross(up, t));
    for (int i = 0; i < nBeads; ++i) {
        int im = max(i - 1, 0), ip = min(i + 1, nBeads - 1);
        vec3 ti = normalize(pos[b0 + ip].xyz - pos[b0 + im].xyz);
        n = n - dot(n, ti) * ti;
        float ln = length(n);
        n = (ln > 1e-6) ? n / ln : normalize(cross(abs(ti.z) < 0.9 ? vec3(0, 0, 1) : vec3(1, 0, 0), ti));
        vec3 bb = cross(ti, n);
        // material twist: rotate the transported frame by the molecule's theta
        float th = theta[m];
        float c = cos(th), s = sin(th);
        vec3 nm = n * c + bb * s;
        vec3 bm = -n * s + bb * c;
        frm[b0 + i] = quatFromMat(nm, bm, ti);
    }
}

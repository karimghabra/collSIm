#version 460
// Apply the Metropolis decision without a CPU round trip.
//
// On rejection the chain must STAY PUT, so the proposal buffer is overwritten
// with the current state; the caller then swaps unconditionally. Staying put is
// what makes the sampled distribution exact -- and equally, it is why a
// rejection is not a physical Brownian event and why the acceptance rate has
// to be kept near 1 for the trajectory to remain interpretable as dynamics.
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer Pos { vec4 pos[]; };
layout(std430, binding = 5) buffer PosNew { vec4 posNew[]; };
layout(std430, binding = 13) readonly buffer Theta { float theta[]; };
layout(std430, binding = 2) buffer ThetaNew { float thetaNew[]; };
layout(std430, binding = 14) readonly buffer Total { double total[]; };

uniform int nBead;
uniform int nMol;

void main() {
    if (total[6] > 0.5lf) return;          // accepted: proposal already correct
    uint i = gl_GlobalInvocationID.x;
    if (i < uint(nBead)) posNew[i] = pos[i];
    if (i < uint(nMol)) thetaNew[i] = theta[i];
}

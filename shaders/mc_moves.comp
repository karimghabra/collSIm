#version 460
// Metropolis rigid-body moves on whole molecules, interleaved with BD.
// Trial moves: translation, rotation, axial slide (registry hops), twist.
// dE evaluated against the same registry energetics as the force pass;
// accepted moves write positions/theta directly. Sparse selection per pass
// keeps simultaneous movers effectively non-interacting.
layout(local_size_x = 128) in;
layout(std430, binding = 0) buffer Pos { vec4 pos[]; };
layout(std430, binding = 1) readonly buffer Off { uint off[]; };
layout(std430, binding = 2) readonly buffer Ids { uint ids[]; };
layout(std430, binding = 6) readonly buffer Frames { vec4 frm[]; };
layout(std430, binding = 10) buffer Stats { uint stats[]; };
layout(std430, binding = 11) readonly buffer Cnt { uint cnt[]; };
layout(std430, binding = 13) buffer Theta { float theta[]; };
layout(std430, binding = 3) readonly buffer NbrList { uint nbr[]; };
layout(std430, binding = 4) readonly buffer NbrCnt { uint nbrCnt[]; };
uniform int nbrCap;
layout(binding = 0) uniform sampler1D parTex;
layout(binding = 1) uniform sampler1D apTex;
layout(binding = 2) uniform sampler3D parTex2;
layout(binding = 3) uniform sampler3D apTex2;

uniform int nMol, nBeads;
uniform float segLen;
uniform vec3 boxHalf;
uniform vec3 cellSize;
uniform vec3 gridDim;
uniform int pbc;
uniform float rRep, kRep, attR0, attW, cutoff;
uniform float epsEl, epsHy, epsNs, apMix;
uniform float kWall, kT;
uniform int registryMode;
uniform float profDs;
uniform int nPar, nAp;
uniform float p2Dstep, p2S0;
uniform int p2nD, p2nR, p2nPhi;
uniform uint seed, mcStep;
uniform int stride;             // select ~nMol/stride movers per pass
uniform float ampT, ampR, ampS, ampTw;

uvec4 pcg4d(uvec4 v) {
    v = v * 1664525u + 1013904223u;
    v.x += v.y * v.w; v.y += v.z * v.x; v.z += v.x * v.y; v.w += v.y * v.z;
    v ^= v >> 16u;
    v.x += v.y * v.w; v.y += v.z * v.x; v.z += v.x * v.y; v.w += v.y * v.z;
    return v;
}
float u01(uint r) { return (float(r >> 8) + 0.5) / 16777216.0; }

vec3 qrot(vec4 q, vec3 v) { return v + 2.0 * cross(q.xyz, cross(q.xyz, v) + q.w * v); }
vec4 qmul(vec4 a, vec4 b) {
    return vec4(a.w * b.xyz + b.w * a.xyz + cross(a.xyz, b.xyz),
                a.w * b.w - dot(a.xyz, b.xyz));
}
vec4 axAngle(vec3 ax, float ang) { return vec4(ax * sin(0.5 * ang), cos(0.5 * ang)); }

vec3 mimg(vec3 d) {
    if (pbc == 0) return d;
    vec3 bs = 2.0 * boxHalf;
    return d - bs * round(d / bs);
}
ivec3 cellOf(vec3 x) {
    vec3 w = x + boxHalf;
    if (pbc == 1) w = mod(mod(w, 2.0 * boxHalf) + 2.0 * boxHalf, 2.0 * boxHalf);
    return clamp(ivec3(floor(w / cellSize)), ivec3(0), ivec3(gridDim) - 1);
}
int cellIdx(ivec3 c) {
    ivec3 gd = ivec3(gridDim);
    return (c.z * gd.y + c.y) * gd.x + c.x;
}
void segClosest(vec3 P1, vec3 D1, vec3 P2, vec3 D2, out float s, out float t) {
    vec3 r = P1 - P2;
    float a = dot(D1, D1), e = dot(D2, D2);
    float b = dot(D1, D2), c = dot(D1, r), f = dot(D2, r);
    if (e < 1e-9 || a < 1e-9) { s = 0.0; t = 0.0; return; }
    float den = a * e - b * b;
    s = (den > 1e-7) ? clamp((b * f - c * e) / den, 0.0, 1.0) : 0.0;
    t = (b * s + f) / e;
    if (t < 0.0)      { t = 0.0; s = clamp(-c / a, 0.0, 1.0); }
    else if (t > 1.0) { t = 1.0; s = clamp((b - c) / a, 0.0, 1.0); }
}
vec2 sampPar(float delta) {
    return texture(parTex, (delta / profDs + float(nPar - 1) * 0.5 + 0.5) / float(nPar)).rg;
}
vec2 sampAp(float rho) {
    return texture(apTex, (rho / profDs + 0.5) / float(nAp)).rg;
}
vec2 samp3Par(float delta, float pa, float pb) {
    vec3 tc = vec3(pb / 6.2831853 + 0.5, pa / 6.2831853 + 0.5,
                   (delta / p2Dstep + float(p2nD - 1) * 0.5 + 0.5) / float(p2nD));
    return texture(parTex2, tc).rg;
}
vec2 samp3Ap(float rho, float pa, float pb) {
    vec3 tc = vec3(pb / 6.2831853 + 0.5, pa / 6.2831853 + 0.5,
                   ((rho + 2.0 * p2S0) / p2Dstep + 0.5) / float(p2nR));
    return texture(apTex2, tc).rg;
}

// energy of one segment of molecule m against all OTHER molecules, with m's
// endpoints/frames optionally passed through the trial transform
float segEnergy(int m, int k, vec3 C, vec4 Q, vec3 T, int apply) {
    float E = 0.0;
    ivec3 gd = ivec3(gridDim);
    {
        int bi = m * nBeads + k;
        vec3 A0 = pos[bi].xyz, A1 = pos[bi + 1].xyz;
        vec4 qA = frm[bi];
        if (apply == 1) {
            A0 = qrot(Q, A0 - C) + C + T;
            A1 = qrot(Q, A1 - C) + C + T;
            qA = normalize(qmul(Q, qA));
        }
        vec3 dA = A1 - A0;
        vec3 tA = normalize(dA);
        float sA0 = float(k) * segLen;
        // walls (non-pbc)
        if (pbc == 0) {
            vec3 ov = max(abs(0.5 * (A0 + A1)) - boxHalf, vec3(0.0));
            E += 0.5 * kWall * dot(ov, ov);
        }
        vec3 mid = 0.5 * (A0 + A1);
        ivec3 cc = cellOf(mid);
        for (int dz = -1; dz <= 1; ++dz)
        for (int dy = -1; dy <= 1; ++dy)
        for (int dx = -1; dx <= 1; ++dx) {
            ivec3 c = cc + ivec3(dx, dy, dz);
            if (pbc == 1) c = (c % gd + gd) % gd;
            else if (any(lessThan(c, ivec3(0))) || any(greaterThanEqual(c, gd))) continue;
            int ci = cellIdx(c);
            uint b0 = off[ci], num = cnt[ci];
            for (uint kk = 0u; kk < num; ++kk) {
                uint j = ids[b0 + kk];
                int molJ = int(j) / (nBeads - 1);
                if (molJ == m) continue;
                int kJ = int(j) % (nBeads - 1);
                int bj = molJ * nBeads + kJ;
                vec3 B0 = pos[bj].xyz, B1 = pos[bj + 1].xyz;
                vec3 midB = 0.5 * (B0 + B1);
                vec3 shiftI = mimg(midB - mid) - (midB - mid);
                B0 += shiftI; B1 += shiftI;
                float u, v;
                segClosest(A0, dA, B0, B1 - B0, u, v);
                vec3 xa = A0 + u * dA, xb = B0 + v * (B1 - B0);
                vec3 dvec = xb - xa;
                float d = length(dvec);
                if (d > cutoff || d < 1e-5) continue;
                if (d < rRep) { float o = rRep - d; E += 0.5 * kRep * o * o; }
                float env = exp(-((d - attR0) * (d - attR0)) / (attW * attW));
                vec3 tB = normalize(B1 - B0);
                float ca = dot(tA, tB);
                float wp = ca > 0.0 ? ca * ca : 0.0;
                float wa = ca < 0.0 ? ca * ca * apMix : 0.0;
                float sB0 = float(kJ) * segLen;
                float sgn = ca >= 0.0 ? 1.0 : -1.0;
                vec3 tP = tA + sgn * tB;
                float lp = length(tP);
                tP = lp > 1e-5 ? tP / lp : tA;
                float axial = dot(dvec, tP);
                float delta = (sA0 + u * segLen) - (sB0 + v * segLen) + axial;
                float rho = (sA0 + u * segLen) + (sB0 + v * segLen) + axial;
                float G = -epsNs;
                if (registryMode == 1) {
                    if (wp > 1e-3) { vec2 u0 = sampPar(delta); G += wp * (epsEl * u0.r + epsHy * u0.g); }
                    if (wa > 1e-3) { vec2 u0 = sampAp(rho); G += wa * (epsEl * u0.r + epsHy * u0.g); }
                } else if (registryMode == 2 && (wp > 1e-3 || wa > 1e-3)) {
                    vec4 qb0 = frm[bj], qb1 = frm[bj + 1];
                    if (dot(qb0, qb1) < 0.0) qb1 = -qb1;
                    vec4 qB = normalize(mix(qb0, qb1, v));
                    vec3 nh = dvec / d;
                    vec3 nA = qrot(qA, vec3(1, 0, 0)), bA = qrot(qA, vec3(0, 1, 0));
                    vec3 nB = qrot(qB, vec3(1, 0, 0)), bB = qrot(qB, vec3(0, 1, 0));
                    float pa = atan(dot(nh, bA), dot(nh, nA));
                    float pb = atan(dot(-nh, bB), dot(-nh, nB));
                    if (wp > 1e-3) { vec2 u0 = samp3Par(delta, pa, pb); G += wp * (epsEl * u0.r + epsHy * u0.g); }
                    if (wa > 1e-3) { vec2 u0 = samp3Ap(rho, pa, pb); G += wa * (epsEl * u0.r + epsHy * u0.g); }
                }
                E += env * G;
            }
        }
    }
    return E;
}

uint selHash(int mol) {
    return pcg4d(uvec4(uint(mol), mcStep, seed, 0x51ed270bu)).x;
}

shared float sE[128];
shared uint sConflict;
shared vec3 shC;
shared vec4 shQ;
shared vec3 shT;
shared float shTw;
shared uint shAccept;

void main() {
    // one workgroup per molecule: 128 threads cooperate on the energy sums
    int m = int(gl_WorkGroupID.x);
    if (m >= nMol) return;
    uint lid = gl_LocalInvocationID.x;
    uvec4 r = pcg4d(uvec4(uint(m), mcStep, seed, 0x51ed270bu));
    if (r.x % uint(stride) != 0u) return;   // uniform across the group

    // conflict mask, parallel over segments: yield to any simultaneously
    // selected interacting molecule with higher priority (detailed balance)
    if (lid == 0u) sConflict = 0u;
    barrier();
    for (int k = int(lid); k < nBeads - 1; k += 128) {
        uint segI = uint(m * (nBeads - 1) + k);
        uint num = nbrCnt[segI];
        uint lbase = segI * uint(nbrCap);
        for (uint kk = 0u; kk < num && sConflict == 0u; ++kk) {
            int molJ = int(nbr[lbase + kk]) / (nBeads - 1);
            if (molJ == m) continue;
            uint hj = selHash(molJ);
            if (hj % uint(stride) == 0u && hj < r.x) { atomicOr(sConflict, 1u); break; }
        }
    }
    barrier();
    if (sConflict != 0u) return;

    int b0 = m * nBeads;
    if (lid == 0u) {
        vec3 C = vec3(0.0);
        for (int i = 0; i < nBeads; i += 4) C += pos[b0 + i].xyz;
        C /= float((nBeads + 3) / 4);
        vec3 axis = normalize(pos[b0 + nBeads - 1].xyz - pos[b0].xyz);
        uvec4 r2 = pcg4d(r);
        float g1 = sqrt(-2.0 * log(u01(r2.x))) * cos(6.2831853 * u01(r2.y));
        float g2 = sqrt(-2.0 * log(u01(r2.x))) * sin(6.2831853 * u01(r2.y));
        float g3 = sqrt(-2.0 * log(u01(r2.z))) * cos(6.2831853 * u01(r2.w));
        vec4 Q = vec4(0, 0, 0, 1);
        vec3 T = vec3(0.0);
        float dTw = 0.0;
        uint mtype = r.y % 4u;
        if (mtype == 0u) T = vec3(g1, g2, g3) * ampT;
        else if (mtype == 1u) Q = axAngle(normalize(vec3(g1, g2, g3 + 1e-4)),
                                          u01(r.z) * ampR * 2.0 - ampR);
        else if (mtype == 2u) T = axis * (u01(r.z) * 2.0 - 1.0) * ampS;
        else { dTw = (u01(r.z) * 2.0 - 1.0) * ampTw; Q = axAngle(axis, dTw); }
        shC = C; shQ = Q; shT = T; shTw = dTw;
    }
    barrier();

    // parallel dE: each thread handles a subset of segments
    float e = 0.0;
    for (int k = int(lid); k < nBeads - 1; k += 128) {
        e += segEnergy(m, k, shC, shQ, shT, 1);
        e -= segEnergy(m, k, shC, vec4(0, 0, 0, 1), vec3(0.0), 0);
    }
    sE[lid] = e;
    barrier();
    for (uint sft = 64u; sft > 0u; sft >>= 1u) {
        if (lid < sft) sE[lid] += sE[lid + sft];
        barrier();
    }

    if (lid == 0u) {
        atomicAdd(stats[5], 1u);
        float dE = sE[0];
        uvec4 ra = pcg4d(pcg4d(r));
        shAccept = (dE <= 0.0 || u01(ra.x) < exp(-dE / kT)) ? 1u : 0u;
        if (shAccept == 1u) {
            atomicAdd(stats[6], 1u);
            if (shTw != 0.0) theta[m] += shTw;
        }
    }
    barrier();
    if (shAccept == 1u) {
        for (int i = int(lid); i < nBeads; i += 128) {
            int b = b0 + i;
            pos[b].xyz = qrot(shQ, pos[b].xyz - shC) + shC + shT;
        }
    }
}

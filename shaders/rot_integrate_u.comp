#version 460
// Rotational Langevin step for the per-molecule twist DOF, rigorous engine.
//
// Same shape as rot_integrate.comp but with NO torque clamp, and it publishes
// the summed generalised force so the Metropolis test can evaluate the reverse
// proposal density at the proposed state.
//
// Sign: phi_a is the azimuth of the contact in A's material frame, so rotating
// A by +theta moves the contact to phi_a - theta, i.e. d(phi_a)/d(theta) = -1.
// The generalised force is therefore -dU/dtheta = +dU/dphi_a, which is exactly
// what the pair pass accumulates into segTq.
layout(local_size_x = 64) in;
layout(std430, binding = 12) readonly buffer SegTq { float segTq[]; };
layout(std430, binding = 13) readonly buffer Theta { float theta[]; };
layout(std430, binding = 2) writeonly buffer ThetaNew { float thetaNew[]; };
layout(std430, binding = 4) writeonly buffer ThTq { float thTq[]; };
layout(std430, binding = 8) writeonly buffer QTh { float qTh[]; };

uniform int nMol;
uniform int nBeads;
uniform float dt, gammaRot, kT;
uniform uint seed;
uniform int driftOnly;

uvec4 pcg4d(uvec4 v) {
    v = v * 1664525u + 1013904223u;
    v.x += v.y * v.w; v.y += v.z * v.x; v.z += v.x * v.y; v.w += v.y * v.z;
    v ^= v >> 16u;
    v.x += v.y * v.w; v.y += v.z * v.x; v.z += v.x * v.y; v.w += v.y * v.z;
    return v;
}

void main() {
    uint m = gl_GlobalInvocationID.x;
    if (m >= uint(nMol)) return;
    int base = int(m) * (nBeads - 1);
    float tq = 0.0;
    for (int k = 0; k < nBeads - 1; ++k) tq += segTq[base + k];
    thTq[m] = tq;
    if (driftOnly == 1) return;

    uvec4 r = pcg4d(uvec4(m, seed, 0x2545F491u, 0x9E3779B9u));
    float u1 = (float(r.x >> 8) + 0.5) / 16777216.0;
    float u2 = (float(r.y >> 8) + 0.5) / 16777216.0;
    float g = sqrt(-2.0 * log(u1)) * cos(6.2831853 * u2);
    float disp = sqrt(2.0 * kT * dt / gammaRot) * g;
    qTh[m] = disp * disp;
    thetaNew[m] = theta[m] + (dt / gammaRot) * tq + disp;
}
